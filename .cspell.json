{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "enableFiletypes": [
    "markdown",
    "mdx"
  ],
  "ignorePaths": [
    "node_modules/**",
    ".git/**",
    "**/*.min.*",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "reports/**",
    ".docs-assist/loop/**"
  ],
  "ignoreRegExpList": [
    "Urls",
    "Email",
    "HexValues",
    "/`{3}[\\s\\S]*?`{3}/g",
    "/`[^`\\n]+`/g"
  ],
  "words": [
    "Angert",
    "antipattern",
    "antipatterns",
    "Astro",
    "Benedetti",
    "bisectable",
    "blocklist",
    "bypassable",
    "contenttype",
    "cspell",
    "debias",
    "debiased",
    "devrel",
    "DNSSEC",
    "doas",
    "docs-assist",
    "docstrings",
    "Docusaurus",
    "dogfooded",
    "dogfooding",
    "dogfoods",
    "Fabrizio",
    "Ferri",
    "followable",
    "frontmatter",
    "Frontmatter",
    "gitignoring",
    "gooddocs",
    "highlightable",
    "ignorecase",
    "inspectable",
    "linkcheck",
    "llms",
    "llmstxt",
    "markdownlint",
    "mdx",
    "MegaLinter",
    "mkdocs",
    "myapi",
    "npx",
    "operationalized",
    "overclaim",
    "overclaiming",
    "pyproject",
    "quickstarts",
    "reformatters",
    "rescoped",
    "roleplay",
    "rulebook",
    "scroller",
    "triaging",
    "unauditable",
    "unbuilt",
    "uncitable",
    "uncited",
    "underbuild",
    "unknowables",
    "unrunnable",
    "unstarted",
    "untimed",
    "unvalidated",
    "upserted",
    "upserts",
    "venv",
    "Workstream",
    "workstreams"
  ]
}
